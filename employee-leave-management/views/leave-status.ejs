<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Leave Status - Employee Leave Management System</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <%- include('partials/nav', { active: 'leave-status' }) %>

  <main class="page">
    <%- include('partials/flash') %>

    <h1 class="page-title">My Leave Requests</h1>
    <p class="page-subtitle">Track the status of every leave request you have submitted.</p>

    <% if (!leaves || leaves.length === 0) { %>
      <div class="empty-state">
        <p>You haven't submitted any leave requests yet.</p>
        <a href="/apply-leave" class="btn btn-primary">Apply for Leave</a>
      </div>
    <% } else { %>
      <div class="table-wrapper">
        <table class="leave-table">
          <thead>
            <tr>
              <th>Leave ID</th>
              <th>Leave Type</th>
              <th>From Date</th>
              <th>To Date</th>
              <th>Reason</th>
              <th>Applied Date</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% leaves.forEach(function (leave) { %>
              <%
                const leaveStatus = (leave && leave.status ? String(leave.status) : '');
                const normalizedStatus = leaveStatus.trim();
                const statusClass = normalizedStatus ? normalizedStatus.toLowerCase().replace(/\s+/g, '-') : 'unknown';
                const isPending = normalizedStatus.toLowerCase() === 'pending';
              %>
              <tr>
                <td><%= leave.id %></td>
                <td><%= leave.leaveType %></td>
                <td><%= leave.fromDate %></td>
                <td><%= leave.toDate %></td>
                <td><%= leave.reason %></td>
                <td><%= leave.appliedDate %></td>
                <td>
                  <span class="status-badge status-<%= statusClass %>"><%= normalizedStatus || 'Unknown' %></span>
                </td>
                <td>
                  <% if (isPending) { %>
                    <form method="POST" action="/leave/<%= leave.id %>/cancel" style="display:inline;" onsubmit="return confirm('Cancel this leave request?');">
                      <button type="submit" class="btn btn-danger">Cancel</button>
                    </form>
                  <% } else { %>
                    <span>-</span>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>