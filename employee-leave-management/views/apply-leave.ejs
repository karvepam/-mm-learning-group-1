<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Apply Leave - Employee Leave Management System</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/nav', { active: 'apply-leave' }) %>

  <main class="page">
    <h1 class="page-title">Apply for Leave</h1>
    <p class="page-subtitle">Fill in the details below to submit a new leave request.</p>
    <p class="page-subtitle">You have <strong><%= summary.remaining %></strong> day(s) remaining.</p>

    <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
      <div class="alert alert-error">
        <ul class="error-list">
          <% errors.forEach(function(err) { %>
            <li><%= err %></li>
          <% }); %>
        </ul>
      </div>
    <% } %>

    <form action="/apply-leave" method="POST" class="form card-form" id="applyLeaveForm">
      <div class="form-group">
        <label for="employeeId">Employee ID</label>
        <input type="text" id="employeeId" name="employeeId" value="<%= employee.employeeId %>" readonly>
      </div>

      <div class="form-group">
        <label for="leaveType">Leave Type</label>
        <select id="leaveType" name="leaveType" required>
          <option value="" disabled <%= !formData.leaveType ? 'selected' : '' %>>Select leave type</option>
          <% leaveTypes.forEach(function(type) { %>
            <option value="<%= type %>" <%= formData.leaveType === type ? 'selected' : '' %>><%= type %></option>
          <% }); %>
        </select>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="fromDate">From Date</label>
          <input type="date" id="fromDate" name="fromDate" value="<%= formData.fromDate || '' %>" required>
        </div>

        <div class="form-group">
          <label for="toDate">To Date</label>
          <input type="date" id="toDate" name="toDate" value="<%= formData.toDate || '' %>" required>
        </div>
      </div>

      <div class="form-group">
        <label for="reason">Reason</label>
        <textarea id="reason" name="reason" rows="4" placeholder="Briefly describe the reason for your leave" required><%= formData.reason || '' %></textarea>
      </div>

      <button type="submit" class="btn btn-primary">Submit Leave Request</button>
    </form>
  </main>

  <script src="/js/app.js"></script>
</body>
</html>
